<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HWPerformance.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
        x:Class="HWPerformance.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="HWPerformance"
        Background="{DynamicResource AppBackgroundBrush}"
        
        Width="1280" 
        Height="720">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>           


    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <TabControl Margin="10">

            <TabItem Header="Hardware">
                <StackPanel HorizontalAlignment="Left" 
                            VerticalAlignment="Top" 
                            Spacing="15"
                            Margin="0,0,0,20">

                    <StackPanel Orientation="Horizontal">
                         <TextBlock Text="GPU: " 
                               FontSize="22" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,0"/>

                         <TextBlock Text="{Binding hardwareSpecs.Gpu.Name}" 
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               FontSize="22"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                         <TextBlock Text="CPU: " 
                               FontSize="22" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,0"/>

                         <TextBlock Text="{Binding hardwareSpecs.Cpu.Name}" 
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               FontSize="22"/>
                    </StackPanel>



                    <TextBlock Text="{Binding hardwareSpecs.Ram.Name}" 
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Performance Metrics">
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Spacing="15">
                    
                    <TextBlock Text="CPU Temperature"
                               FontSize="20"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding Data.CpuMetrics.Temperature}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" />

                     <TextBlock Text="GPU Temperature"
                               FontSize="20"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding Data.GpuMetrics.Temperature}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" />

                    <Button Content="Start Monitoring"
                            Command="{Binding StartMonitoringCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>
            
        </TabControl>
        
    </Border>
</Window>